#include <18F4550.h>
#use delay(clock=1000000)        
#fuses HS, NOWDT, PUT, BROWNOUT, NOLVP, CPUDIV1

#define led0 pin_b1

int16 conta = -1;
boolean estado_anterior = false,soltou=1;

int digito[10] = {
    0b00111111, // Dígito 0
    0b00000110, // Dígito 1
    0b01011011, // Dígito 2
    0b01001111, // Dígito 3
    0b01100110, // Dígito 4
    0b01101101, // Dígito 5
    0b01111101, // Dígito 6
    0b00000111, // Dígito 7
    0b01111111, // Dígito 8
    0b01101111  // Dígito 9
};

#int_timer0
void trata_t0() {
    static unsigned int32 tempo = 0,num5=0,num4=9, num = 0, num1 = 5, num2 = 9, num3 = 5; //num5,num4-Hora num3,num2-Min num1,num-Seg

    // RESET
    if (input(pin_b0) == 0) {
        num = 0;
        num1 = 0;
        num2 = 0;
        num3 = 0;
        num4=0;
        num5=0;
    }

    // PAUSE
    if (input(pin_b1) == 0) {
        estado_anterior = !estado_anterior;
    }

    SET_TIMER0(131 + get_timer0());

    conta++;
    if (conta > 5) conta = 0;

    switch (conta) {
        case 0:
            OUTPUT_D(digito[num5]);
            OUTPUT_A(0b11111110);
            break;
        case 1:
            OUTPUT_D(digito[num4]);
            OUTPUT_A(0b11111101);
            break;
        case 2:
            OUTPUT_D(digito[num3]);
            OUTPUT_A(0b11111011);
            break;
        case 3:
            OUTPUT_D(digito[num2]);
            OUTPUT_A(0b11110111);
            break;
        case 4:
            OUTPUT_D(digito[num1]);
            OUTPUT_A(0b11101111);
            break;
        case 5:
            OUTPUT_D(digito[num]);
            OUTPUT_A(0b11011111);
            break;
    }

    if (!estado_anterior) {
        tempo++;
        if (tempo == 32) {
            tempo = 0;
            num++;
            if (num > 9) {
                num = 0;
                num1++;
            }
            if (num1 > 5) {
                num1 = 0;
                num2++;
            }
            if (num2 > 9) {
                num2 = 0;
                num3++;
            }
            if (num3 > 5) {
                num3 = 0;
                num4++;
            }
            if(num4 > 9){
               num4 = 0;
               num5++;
            }
            if(num5 == 2 && num4 > 4){
               num4=0;
               num5=0;
            }
        }
    }
    
    if(!input(pin_b2) && soltou && num5 <2){
      num5++;
      soltou=0;
    }
    
    if(!input(pin_b3) && soltou){
      num4++;
      soltou=0;
    }
    
    if(!input(pin_b4) && soltou){
      num3++;
      soltou=0;
    }
    if(input(pin_b2)&&input(pin_b3)&&input(pin_b4)){
      soltou=1;
    }
}

void main() {
    port_b_pullups(TRUE);
    ENABLE_INTERRUPTS(GLOBAL | INT_TIMER0);  
    setup_timer_0(RTCC_DIV_64 | RTCC_INTERNAL | RTCC_8_BIT); // 8 bits
    while (true) {
        // Loop principal vazio, lógica toda na interrupção
    }
}
